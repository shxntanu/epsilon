# epsilond service
EPSILOND_HTTP_ADDR=:8080
EPSILOND_SHUTDOWN_TIMEOUT=10s
EPSILOND_MAX_EVENT_BODY_BYTES=1048576

# Durable services
EPSILOND_POSTGRES_DSN=postgres://epsilon:epsilon@localhost:5432/epsilon?sslmode=disable
EPSILOND_AUTO_MIGRATE=true
EPSILOND_TEMPORAL_ADDRESS=localhost:7233
EPSILOND_TEMPORAL_NAMESPACE=default
EPSILOND_TEMPORAL_TASK_QUEUE=epsilond

# Model provider
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
EPSILOND_WORKER_PROVIDER=fake
EPSILOND_WORKER_MODEL=
EPSILOND_WORKER_EFFORT=
EPSILOND_WORKER_SYSTEM_PROMPT=

# Model routes. Provider is a routing label; model is passed through to the active provider/router.
EPSILOND_MODEL_ORCHESTRATOR_FRONTIER_PROVIDER=
EPSILOND_MODEL_ORCHESTRATOR_FRONTIER_MODEL=
EPSILOND_MODEL_ORCHESTRATOR_FRONTIER_EFFORT=high
EPSILOND_MODEL_ORCHESTRATOR_FRONTIER_MAX_TOKENS=32000
EPSILOND_MODEL_ORCHESTRATOR_FRONTIER_INPUT_COST_PER_1M=0
EPSILOND_MODEL_ORCHESTRATOR_FRONTIER_OUTPUT_COST_PER_1M=0
EPSILOND_MODEL_WORKER_DEFAULT_CODE_PROVIDER=
EPSILOND_MODEL_WORKER_DEFAULT_CODE_MODEL=
EPSILOND_MODEL_WORKER_DEFAULT_CODE_EFFORT=medium
EPSILOND_MODEL_WORKER_DEFAULT_CODE_MAX_TOKENS=16000
EPSILOND_MODEL_WORKER_DEFAULT_CODE_INPUT_COST_PER_1M=0
EPSILOND_MODEL_WORKER_DEFAULT_CODE_OUTPUT_COST_PER_1M=0
EPSILOND_MODEL_WORKER_DEFAULT_ARTIFACT_PROVIDER=
EPSILOND_MODEL_WORKER_DEFAULT_ARTIFACT_MODEL=
EPSILOND_MODEL_WORKER_ESCALATION_PROVIDER=
EPSILOND_MODEL_WORKER_ESCALATION_MODEL=
EPSILOND_MODEL_CHEAP_CLASSIFIER_PROVIDER=
EPSILOND_MODEL_CHEAP_CLASSIFIER_MODEL=
EPSILOND_MODEL_SUMMARIZER_PROVIDER=
EPSILOND_MODEL_SUMMARIZER_MODEL=
EPSILOND_MODEL_MEMORY_DISTILLER_PROVIDER=
EPSILOND_MODEL_MEMORY_DISTILLER_MODEL=

# Memory
EPSILOND_MEM0_BASE_URL=http://localhost:8888
EPSILOND_MEM0_API_KEY=

# Google Chat
EPSILOND_GOOGLE_CHAT_AUDIENCE=
EPSILOND_GOOGLE_CHAT_SERVICE_KEY=
EPSILOND_GOOGLE_CHAT_ACCESS_TOKEN=
EPSILOND_ALLOWED_SPACES=

# Workspaces and repo access
EPSILOND_WORKSPACE_ROOT=/data/workspaces
EPSILOND_REPO_CACHE_ROOT=/data/repo-cache
EPSILOND_ALLOWED_REPOS=
EPSILOND_SANDBOX_BACKEND=harness
EPSILOND_SRT_BINARY=srt

# Budgets
EPSILOND_PER_TASK_TOKEN_BUDGET=200000
EPSILOND_PER_THREAD_DAILY_TOKEN_BUDGET=1000000
EPSILOND_PER_SPACE_DAILY_TOKEN_BUDGET=10000000
